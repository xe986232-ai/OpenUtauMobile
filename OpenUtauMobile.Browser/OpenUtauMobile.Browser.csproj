<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>
        <DefineConstants>BROWSER</DefineConstants>
        <WasmEnableThreads>true</WasmEnableThreads>
        <EmccExtraLDFlags>$(EmccExtraLDFlags) -lidbfs.js</EmccExtraLDFlags>
        <!-- 插件发现和现有 JSON 模型依赖反射，浏览器发布时保留其元数据。 -->
        <PublishTrimmed>false</PublishTrimmed>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(WasmEnableThreads)' == 'true'">
        <!-- .NET 10 多线程原生运行时在 -O0 下启动崩溃；仅优化原生部分，保留托管调试。 -->
        <EmccCompileOptimizationFlag>-Oz</EmccCompileOptimizationFlag>
        <EmccLinkOptimizationFlag>-O2</EmccLinkOptimizationFlag>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0"/>
    </ItemGroup>

    <!-- AOT 编译器在 SDL3-CS 等桌面专用程序集上会崩溃；浏览器用不到它们，改走解释器以跳过 AOT。 -->
    <ItemGroup Condition="'$(RunAOTCompilation)' == 'true'">
        <_AOT_InternalForceInterpretAssemblies Include="SDL3-CS.dll"/>
        <_AOT_InternalForceInterpretAssemblies Include="OpenUtauMobile.dll"/>
        <_AOT_InternalForceInterpretAssemblies Include="Tmds.DBus.Protocol.dll"/>
        <_AOT_InternalForceInterpretAssemblies Include="NAudio.dll"/>
        <_AOT_InternalForceInterpretAssemblies Include="NAudio.Core.dll"/>
        <_AOT_InternalForceInterpretAssemblies Include="NAudio.Wasapi.dll"/>
        <_AOT_InternalForceInterpretAssemblies Include="NAudio.WinMM.dll"/>
        <_AOT_InternalForceInterpretAssemblies Include="NAudio.Asio.dll"/>
        <_AOT_InternalForceInterpretAssemblies Include="NAudio.Midi.dll"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenUtauMobile\OpenUtauMobile.csproj"/>
    </ItemGroup>
</Project>
